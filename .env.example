# You do not have to edit this file by hand. Either of these writes it for you:
#   python -m nifty_options credentials      (prompts, hides the secret)
#   python -m nifty_options dashboard        (enter them once in the page)
#
# Create an app at https://account.upstox.com/developer/apps and register the
# redirect URI below on it -- the login flow captures the daily token there.
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://127.0.0.1:5000/callback

# Optional escape hatch: supply a daily access token directly instead of
# running the browser login. Overrides the stored token file for the session.
# UPSTOX_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# THE SWITCH. Leave unset (or 'paper') for simulated trading.
# ---------------------------------------------------------------------------
UPSTOX_TRADING_MODE=paper

# Required only when UPSTOX_TRADING_MODE=live. Must match
# live.confirmation_phrase in config.yaml, character for character.
# UPSTOX_LIVE_CONFIRM=I UNDERSTAND THIS TRADES REAL MONEY

LOG_LEVEL=INFO
